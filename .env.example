# Project Environment Variables Template
# Copy this file to .env and adjust values for local development.
# NEVER commit real .env files to source control!

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Configuration
# Provider choices: mock | openai | gemini | ollama
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL_NAME=gpt-4o-mini

# Embeddings Configuration
# Provider choices: mock | openai | huggingface
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Vector Store Configuration
# Store choices: in_memory | pgvector
VECTOR_STORE_TYPE=in_memory

# Synthetic Data Paths
DATA_DIR=./data
